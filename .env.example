# justregqa — copy to .env and fill in. Never commit .env.
# Without any key the engine runs in offline "extractive" mode (quotes the clauses themselves).

# Which LLM backend to use for answer synthesis: none | anthropic | openai
REGQA_LLM=none

# --- anthropic ---
ANTHROPIC_API_KEY=
# Set a current model id from the provider's model list (no default on purpose).
REGQA_ANTHROPIC_MODEL=

# --- openai-compatible (OpenAI, DeepSeek, Moonshot, local vLLM/Ollama, ...) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REGQA_OPENAI_MODEL=

# Retrieval
REGQA_TOP_K=4
# Abstain when the best clause covers less than this share of the question's terms (0..1)
REGQA_MIN_COVERAGE=0.15
